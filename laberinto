        "import pygame\n",
        "import random\n",
        "import sys\n",
        "Inicializar Pygame y el mezclador de audio\n",
        "pygame.init()\n",
        "pygame.mixer.init()\n",
        "try:\n",
        "pygame.mixer.music.load(\"arcade.mp3\")\n",
        "pygame.mixer.music.set_volume(0.4)\n",
        "pygame.mixer.music.play(-1)\n",
        "except pygame.error:\n",
        "print(\"Aviso: No se encontró 'arcade.mp3'. El juego iniciará en silencio.\")\n",
        "Definición de Colores (Estilo Arcade / Pac-Man)\n",
        "NEGRO = (0, 0, 0)\n",
        "AMARILLO_PACMAN = (255, 255, 0)\n",
        "ROJO_FANTASMA = (235, 51, 35)\n",
        "AZUL_PARED = (17, 17, 219)\n",
        "BLANCO_PUNTOS = (255, 184, 151)\n",
        "TEXTO_COLOR = (255, 255, 255)\n",
        "Configuración inicial del Nivel 1\n",
        "TAMANO_CELDA = 30\n",
        "nivel = 1\n",
        "ANCHO_COLS = 21\n",
        "ALTO_FILAS = 15\n",
        "ANCHO_VENTANA = ANCHO_COLS * TAMANO_CELDA\n",
        "ANCHO_VENTANA = ANCHO_COLS * TAMANO_CELDA\n",
        "ALTO_VENTANA = ALTO_FILAS * TAMANO_CELDA + 50\n",
        "ventana = pygame.display.set_mode((ANCHO_VENTANA, ALTO_VENTANA))\n",
        "pygame.display.set_caption(\"Pac-Man Procedural Maze - Arcade Edition\")\n",
        "reloj = pygame.time.Clock()\n",
        "def generar_laberinto(cols, filas):\n",
        "laberinto = [[1 for _ in range(cols)] for _ in range(filas)]\n",
        "def es_valido(r, c):\n",
        "return 0 <= r < filas and 0 <= c < cols\n",
        "stack = []\n",
        "inicio_r, inicio_c = 1, 1\n",
        "laberinto[inicio_r][inicio_c] = 0\n",
        "stack.append((inicio_r, inicio_c))\n",
        "while stack:\n",
        "r, c = stack[-1]\n",
        "direcciones = [(-2, 0), (0, 2), (2, 0), (0, -2)]\n",
        "random.shuffle(direcciones)\n",
        "movimiento_encontrado = False\n",
        "for dr, dc in direcciones:\n",
        "vecino_r, vecino_c = r + dr, c + dc\n",
        "if es_valido(vecino_r, vecino_c) and laberinto[vecino_r][vecino_c] == 1:\n",
        "laberinto[r + dr // 2][c + dc // 2] = 0\n",
        "laberinto[vecino_r][vecino_c] = 0\n",
        "stack.append((vecino_r, vecino_c))\n",
        "movimiento_encontrado = True\n",
        "break\n",
        "if not movimiento_encontrado:\n",
        "stack.pop()\n",
        "return laberinto\n",
        "def configurar_nivel():\n",
        "global laberinto, jugador_pos, rastro, meta_pos, movimientos, ANCHO_COLS, ALTO_FILAS, ANCHO_VENTANA, ALTO_VENTANA, ventana\n",
        "# Dificultad progresiva: A mayor nivel, la cuadrícula crece, creando más callejones sin salida\n",
        "ANCHO_COLS = 21 + (nivel - 1) * 2\n",
        "ALTO_FILAS = 15 + (nivel - 1) * 2\n",
        "# Límites máximos para pantallas estándar\n",
        "if ANCHO_COLS > 33: ANCHO_COLS = 33\n",
        "if ALTO_FILAS > 23: ALTO_FILAS = 23\n",
        "ANCHO_VENTANA = ANCHO_COLS * TAMANO_CELDA\n",
        "ALTO_VENTANA = ALTO_FILAS * TAMANO_CELDA + 50\n",
        "ventana = pygame.display.set_mode((ANCHO_VENTANA, ALTO_VENTANA))\n",
        "laberinto = generar_laberinto(ANCHO_COLS, ALTO_FILAS)\n",
        "jugador_pos = [1, 1]\n",
        "meta_pos = [ALTO_FILAS - 2, ANCHO_COLS - 2]\n",
        "laberinto[1][1] = 0\n",
        "laberinto[meta_pos[0]][meta_pos[1]] = 0\n",
        "rastro = set()\n",
        "rastro.add(tuple(jugador_pos))\n",
        "movimientos = 0\n",
        "Variables de Estado\n",
        "movimientos = 0\n",
        "fuente = pygame.font.SysFont(\"Arial\", 18, bold=True)\n",
        "configurar_nivel()\n",
        "Bucle Principal\n",
        "ejecutando = True\n",
        "while ejecutando:\n",
        "ventana.fill(NEGRO)\n",
        "# Manejo de Eventos\n",
        "for evento in pygame.event.get():\n",
        "if evento.type == pygame.QUIT:\n",
        "ejecutando = False\n",
        "elif evento.type == pygame.KEYDOWN:\n",
        "nuevo_r, nuevo_c = jugador_pos[0], jugador_pos[1]\n",
        "tecla_valida = False\n",
        "if evento.key == pygame.K_UP or evento.key == pygame.K_w:\n",
        "nuevo_r -= 1\n",
        "tecla_valida = True\n",
        "elif evento.key == pygame.K_DOWN or evento.key == pygame.K_s:\n",
        "nuevo_r += 1\n",
        "tecla_valida = True\n",
        "elif evento.key == pygame.K_LEFT or evento.key == pygame.K_a:\n",
        "nuevo_c -= 1\n",
        "tecla_valida = True\n",
        "elif evento.key == pygame.K_RIGHT or evento.key == pygame.K_d:\n",
        "nuevo_c += 1\n",
        "tecla_valida = True\n",
        "elif evento.key == pygame.K_r: # Reiniciar nivel actual\n",
        "configurar_nivel()\n",
        "# Conteo estricto de pulsaciones válidas\n",
        "if tecla_valida:\n",
        "movimientos += 1\n",
        "if 0 <= nuevo_r < ALTO_FILAS and 0 <= nuevo_c < ANCHO_COLS:\n",
        "if laberinto[nuevo_r][nuevo_c] == 0:\n",
        "jugador_pos = [nuevo_r, nuevo_c]\n",
        "rastro.add(tuple(jugador_pos))\n",
        "# Si llega a la meta, incrementa el nivel automáticamente y redimensiona\n",
        "if jugador_pos == meta_pos:\n",
        "nivel += 1\n",
        "configurar_nivel()\n",
        "# --- RENDERIZADO ESTILO PAC-MAN ---\n",
        "# 1. Dibujar Paredes y Pasillos\n",
        "for r in range(ALTO_FILAS):\n",
        "for c in range(ANCHO_COLS):\n",
        "rect = pygame.Rect(c * TAMANO_CELDA, r * TAMANO_CELDA, TAMANO_CELDA, TAMANO_CELDA)\n",
        "if laberinto[r][c] == 1:\n",
        "pygame.draw.rect(ventana, AZUL_PARED, rect, border_radius=4)\n",
        "else:\n",
        "pygame.draw.rect(ventana, NEGRO, rect)\n",
        "# 2. Dibujar el rastro (Pastillas de energía)\n",
        "for celda in rastro:\n",
        "r, c = celda\n",
        "if [r, c] != jugador_pos and [r, c] != [1, 1]:\n",
        "centro_x = c * TAMANO_CELDA + TAMANO_CELDA // 2\n",
        "centro_y = r * TAMANO_CELDA + TAMANO_CELDA // 2\n",
        "pygame.draw.circle(ventana, BLANCO_PUNTOS, (centro_x, centro_y), 4)\n",
        "# 3. Dibujar la Meta (Fantasma)\n",
        "f_x = meta_pos[1] * TAMANO_CELDA + TAMANO_CELDA // 2\n",
        "f_y = meta_pos[0] * TAMANO_CELDA + TAMANO_CELDA // 2\n",
        "pygame.draw.circle(ventana, ROJO_FANTASMA, (f_x, f_y - 2), 11)\n",
        "fantasma_cuerpo = pygame.Rect(f_x - 11, f_y - 2, 22, 13)\n",
        "pygame.draw.rect(ventana, ROJO_FANTASMA, fantasma_cuerpo)\n",
        "# 4. Dibujar a Pac-Man\n",
        "p_x = jugador_pos[1] * TAMANO_CELDA + TAMANO_CELDA // 2\n",
        "p_y = jugador_pos[0] * TAMANO_CELDA + TAMANO_CELDA // 2\n",
        "pygame.draw.circle(ventana, AMARILLO_PACMAN, (p_x, p_y), 12)\n",
        "pygame.draw.circle(ventana, NEGRO, (p_x + 3, p_y - 4), 2)\n",
        "# 5. Panel de Información\n",
        "panel_rect = pygame.Rect(0, ALTO_FILAS * TAMANO_CELDA, ANCHO_VENTANA, 50)\n",
        "pygame.draw.rect(ventana, (10, 10, 15), panel_rect)\n",
        "texto_estado = fuente.render(f\"Nivel: {nivel} | Clics: {movimientos} | W,A,S,D / Flechas\", True, TEXTO_COLOR)\n",
        "ventana.blit(texto_estado, (15, ALTO_FILAS * TAMANO_CELDA + 15))\n",
        "pygame.display.flip()\n",
        "reloj.tick(60)\n",
        "pygame.quit()\n",
        "sys.exit()"
      ]
    }
  ]
}